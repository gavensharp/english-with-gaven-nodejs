# Root environment template for VPS deployment
# Copy this file to .env on the VPS root before build/start.
# Do not commit .env with real secrets.
# Keep placeholder values in this template. Never put real secrets here.

NODE_ENV=production
HOST=0.0.0.0
PORT=3001

# Backend / Prisma
DATABASE_URL=mysql://db_user:url_encoded_password@127.0.0.1:3306/db_name
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN=24h

# CORS and app URLs
# Include both origins only if both are actively used.
CORS_ORIGIN=https://www.englishwithgaven.com,https://englishwithgaven.com
FRONTEND_URL=https://www.englishwithgaven.com
NEXT_PUBLIC_BACKEND_URL=https://www.englishwithgaven.com
NEXT_PUBLIC_API_URL=https://www.englishwithgaven.com/api
NEXT_PUBLIC_SITE_URL=https://www.englishwithgaven.com

# Optional Next.js mount override (normally not needed in production)
# MOUNT_NEXT_IN_BACKEND=true
# NEXT_APP_DIR=/absolute/path/to/frontend

# Agora
NEXT_PUBLIC_AGORA_APP_ID=replace-with-agora-app-id
NEXT_PUBLIC_AGORA_CHAT_APP_KEY=yourorg#yourapp
AGORA_APP_ID=replace-with-agora-app-id
AGORA_APP_CERTIFICATE=replace-with-agora-app-certificate
