# Backend Environment Variables (VPS)

NODE_ENV=production
HOST=127.0.0.1
PORT=3001

# MySQL connection string for Prisma
# Format: mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME
DATABASE_URL="mysql://english_with_gaven:URL_ENCODED_PASSWORD@127.0.0.1:3306/u547472789_logindb"

# Auth secrets
JWT_SECRET="replace-with-long-random-secret"
SESSION_SECRET="replace-with-long-random-secret"
JWT_EXPIRES_IN="24h"

# CORS allowlist (backend reads CORS_ORIGIN, then FRONTEND_URL for compatibility)
CORS_ORIGIN="https://yourdomain.com"
FRONTEND_URL="https://yourdomain.com"

# Optional Redis for distributed rate limiting
# Leave REDIS_ENABLED=true (default behavior) when REDIS_URL is present.
# Set REDIS_ENABLED=false to force local in-memory limiter.
REDIS_URL="redis://127.0.0.1:6379"
REDIS_ENABLED="true"

# Agora Credentials
AGORA_APP_ID="your-agora-app-id"
AGORA_APP_CERTIFICATE="your-agora-app-certificate"
