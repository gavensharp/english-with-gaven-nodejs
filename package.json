{
  "name": "english-with-gaven-js",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build:frontend": "npm --prefix frontend ci --include=dev && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend install --include=dev && npm --prefix backend run build",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node index.js",
    "dev:backend": "nodemon --exec ts-node backend/src/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "prisma:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=backend/prisma/schema.prisma",
    "postinstall": "npm run prisma:generate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@prisma/client": "^5.22.0",
    "agora-chat": "^1.3.1",
    "agora-rtc-sdk-ng": "^4.24.2",
    "agora-token": "^2.0.5",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "countries-and-timezones": "^3.8.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "next": "15.5.10",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.3",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "next": "15.5.10"
  }
}
